<launch>
    <arg name="veh"               default="mybot"/>
    <arg name="rotation_duration" default="2.0"/>
    <arg name="loading_duration"  default="3.0"/>
    <arg name="rotation_speed"    default="0.5"/>

    <node pkg="warehouse" type="warehouse_manager_node.py"
          name="warehouse_manager_node" output="screen">
        <param name="veh"               value="$(arg veh)"/>
        <param name="rotation_duration" value="$(arg rotation_duration)"/>
        <param name="loading_duration"  value="$(arg loading_duration)"/>
        <param name="rotation_speed"    value="$(arg rotation_speed)"/>
    </node>

</launch>